# API-ключ Livedune: pro.livedune.com/settings/api. Без ключа дашборд работает на демо-данных
LIVEDUNE_TOKEN=
# Проекты Livedune через запятую. Пусто — все проекты, а в шапке появится переключатель
LIVEDUNE_PROJECT=
# Номера аккаунтов Livedune через запятую, если нужны не все. Пусто — все аккаунты выбранных проектов
LIVEDUNE_ACCOUNTS=
# Название в шапке. Пусто — название проекта или «Дашкрафт»
DASHBOARD_TITLE=
# 1 — принудительно показать демо-данные, даже если ключ задан
DEMO_MODE=

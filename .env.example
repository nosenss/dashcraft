LIVEDUNE_TOKEN=
# Проект в дашборде Livedune. Пусто — берутся все подключённые аккаунты
LIVEDUNE_PROJECT=
# Название в шапке
DASHBOARD_TITLE=
# 1 — принудительно показать демо-данные, даже если ключ задан
DEMO_MODE=
